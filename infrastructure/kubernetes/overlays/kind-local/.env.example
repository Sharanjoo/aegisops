# Copy this file to .env in the same directory and fill in real local
# values. .env is git-ignored (see repo .gitignore's `.env`/`.env.*`
# rules) - never commit it. These are the same four keys used by
# infrastructure/local/.env.example, since both the Docker Compose
# stack and this Kustomize deployment provision the same MySQL
# credentials.
#
# deploy-kind.ps1 also accepts these as real environment variables
# (AEGISOPS_MYSQL_DATABASE, etc. are NOT used - the script reads the
# exact names below to stay consistent with Compose) and prefers
# already-set environment variables over this file.
MYSQL_DATABASE=aegisops
MYSQL_USER=aegisops
MYSQL_PASSWORD=change_me_dev_password
MYSQL_ROOT_PASSWORD=change_me_root_password
